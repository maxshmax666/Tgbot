# --- API (Cloudflare Pages Functions) ---
/api/*  /api/:splat  200

# --- Admin (static files in /webapp/admin) ---
/admin/AdminApp.bundle.js  /admin/AdminApp.bundle.js 200
/admin/*  /admin/:splat  200
/admin    /admin/index.html 200

# --- Static assets (avoid SPA fallback) ---
/app.bundle.js  /app.bundle.js 200
/*.js  /:splat  200
/*.css  /:splat  200
/*.json  /:splat  200
/assets/*  /assets/:splat  200
/data/*  /data/:splat  200
/services/*  /services/:splat  200
/pages/*  /pages/:splat  200
/store/*  /store/:splat  200
/ui/*  /ui/:splat  200

# --- Public SPA (catch-all, exclude admin) ---
/((?!admin).*)  /index.html 200
